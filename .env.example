# Copy to .env for local / Docker use. On Vercel, set these in
# Project -> Settings -> Environment Variables instead. NEVER commit a real key.

# Required. Create a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: comma-separated, tried in order. Must be models that end in ":free".
# See the current list with:  python scripts/list_free_models.py
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,inclusionai/ling-3.2-flash:free,openrouter/free

# Optional tuning (defaults shown)
# TOP_K=6
# MAX_CONTEXT_CHARS=7000
# MAX_OUTPUT_TOKENS=800
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_SECONDS=40
# RATE_LIMIT_PER_MINUTE=20
# CORS_ORIGINS=https://example.com
# APP_URL=https://your-deployment.vercel.app
# LOG_LEVEL=INFO
